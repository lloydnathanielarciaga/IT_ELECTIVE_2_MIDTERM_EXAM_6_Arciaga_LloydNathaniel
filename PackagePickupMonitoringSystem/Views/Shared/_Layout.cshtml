<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PackagePickupMonitoringSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PackagePickupMonitoringSystem.styles.css" asp-append-version="true" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            overflow-x: hidden;
        }
    </style>
</head>
<body>
    <div class="d-flex flex-nowrap min-vh-100">

        <div class="d-flex flex-column flex-shrink-0 p-3 text-bg-dark" style="width: 280px;">
            <a asp-controller="Package" asp-action="Index" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                <span class="fs-5 fw-bold">Package Monitor</span>
            </a>
            <hr>

            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-controller="Package" asp-action="Index" class="nav-link text-white" aria-current="page">
                        Packages List
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="Package" asp-action="Create" class="nav-link text-white">
                        Register Package
                    </a>
                </li>
            </ul>

            <hr>

            <div>
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="mb-2 text-white">
                        <small>Logged in as:</small><br />
                        <strong>@User.Identity.Name</strong>
                    </div>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm w-100">Logout</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm w-100 mb-2">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-sm w-100">Register</a>
                }
            </div>
        </div>

        <div class="flex-grow-1 bg-light">
            <main role="main" class="p-4 p-md-5 w-100">
                @RenderBody()
            </main>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>