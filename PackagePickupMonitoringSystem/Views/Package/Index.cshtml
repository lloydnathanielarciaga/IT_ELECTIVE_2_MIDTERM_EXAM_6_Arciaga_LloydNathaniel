@model IEnumerable<PackagePickupMonitoringSystem.Models.Package>

<h2>Package Monitoring List</h2>

<form method="get" class="mb-3 d-flex">
    <input type="text" name="searchQuery" class="form-control me-2" placeholder="Search by Tracking Number or Recipient..." />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Tracking #</th>
            <th>Recipient</th>
            <th>Courier</th>
            <th>Type</th>
            <th>Arrival Time</th>
            <th>Claimed Time</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TrackingNumber</td>
                <td>@item.RecipientName</td>
                <td>@item.CourierCompany</td>
                <td>@item.PackageType</td>
                <td>@item.ArrivalDateTime.ToString("g")</td>
                <td>@(item.ClaimedDateTime?.ToString("g") ?? "-")</td>
                <td>
                    <span class="badge @(item.Status == "Claimed" ? "bg-success" : "bg-warning")">
                        @item.Status
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    @if (item.Status != "Claimed")
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Edit</a>
                        <a asp-action="Claim" asp-route-id="@item.Id" class="btn btn-sm btn-success">Claim</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Register New Package</a>