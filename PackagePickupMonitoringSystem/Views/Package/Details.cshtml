@model PackagePickupMonitoringSystem.Models.Package

<h2>View Package Details</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TrackingNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.TrackingNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RecipientName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.RecipientName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UnitNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.UnitNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ContactNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ContactNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CourierCompany)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CourierCompany)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ArrivalDateTime)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ArrivalDateTime)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-9">
            @if (Model.Status == "Claimed")
            {
                <span class="badge bg-success">Claimed</span>
            }
            else
            {
                <span class="badge bg-warning">Waiting for Pickup</span>
            }
        </dd>

        @if (Model.Status == "Claimed")
        {
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ClaimedDateTime)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ClaimedDateTime)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ReceivedBy)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ReceivedBy)</dd>
        }

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Notes)</dd>
    </dl>
</div>
<br />

<div>
    @if (Model.Status != "Claimed")
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-secondary">Edit Information</a>
    }
    <a asp-action="Index" class="btn btn-primary">Back to List</a>
</div>